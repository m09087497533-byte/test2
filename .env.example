# Анализ рассказа и проверка изображений: openai или ollama
SCENEMIX_AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Для локального варианта запустите Ollama и установите модель с поддержкой изображений
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma3:4b
# Распознавание аудио локально; small / medium / путь к скачанной модели
WHISPER_MODEL=small
WHISPER_LANGUAGE=ru
# Для стокового видео нужен хотя бы один ключ
PEXELS_API_KEY=
PIXABAY_API_KEY=
